// Prisma schema for Bloom MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  PERIOD_START
  PERIOD_END
  FERTILITY_WINDOW
  SYMPTOM_REMINDER
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  passwordHash  String?
  oauthProvider String?
  oauthId       String?
  isAnonymous   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cycles        Cycle[]
  symptoms      Symptom[]
  notifications Notification[]
  chatLogs      ChatLog[]
}

model Cycle {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Symptom {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mood      String?
  cramps    Int?     // 1-5
  sleep     Int?     // 1-5
  energy    Int?     // 1-5
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id           String            @id @default(cuid())
  userId       String
  type         NotificationType
  scheduledFor DateTime
  delivered    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id])
}

model ChatLog {
  id        String   @id @default(cuid())
  userId    String?
  role      ChatRole
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
